{
  "assignAutomerge": true,
  "extends": ["config:best-practices", ":automergeMinor"],
  "ignorePaths": [
    "docs/**"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "groupName": "io.quarkus",
      "packagePatterns": [
        "^io.quarkus:"
      ]
    },
    {
      "groupName": "org.jetbrains.kotlin",
      "packagePatterns": [
        "^org.jetbrains.kotlin"
      ]
    },
    {
      "groupName": "org.junit.jupiter",
      "packagePatterns": [
        "^org.junit.jupiter:"
      ]
    },
    {
      "groupName": "org.seasar.doma:doma",
      "packagePatterns": [
        "^org.seasar.doma:doma-(core|mock|kotlin|processor|slf4j)"
      ]
    },
    {
      "groupName": "io.quarkiverse.doma:quarkus-doma",
      "packagePatterns": [
        "^io.quarkiverse.doma:quarkus-doma"
      ]
    },
    {
      "matchPackageNames": ["com.google.googlejavaformat:google-java-format"],
      "allowedVersions": "<1.29.0"
    }
  ],
  "reviewers": [
    "nakamura-to"
  ]
}
